---
import '@fontsource-variable/inter'
import { Image } from 'astro:assets'
import Feature from '../components/Feature.astro'
import { latestRelease, releasesUrl, repoUrl } from '../release'

import chat from '../assets/desktop-chat.png'
import dark from '../assets/desktop-dark.png'
import control from '../assets/desktop-control.png'
import settings from '../assets/desktop-settings.png'
import qr from '../assets/desktop-phone.png'
import phoneChat from '../assets/phone-chat.png'
import phoneList from '../assets/phone-computers.png'

const r = await latestRelease()
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const version = r.version ? `Version ${r.version}` : 'Latest version'
const phoneShot = { widths: [300, 600], sizes: '(max-width: 820px) 42vw, 260px' }
const deskShot = { widths: [640, 1100, 1600], sizes: '(max-width: 820px) 92vw, 640px' }
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>dsync — all your devices, one conversation</title>
    <meta name="description" content="Send text, files and folders of any size between your computers and phone, share the clipboard, and control your other computers. Encrypted, on your own network." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href={`${base}/`}>
        <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
        dsync
      </a>
      <nav>
        <a href="#features">Features</a>
        <a href="#download">Download</a>
        <a href={repoUrl}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <p class="pill">{version} · Windows · macOS · Linux · Android · iPhone</p>
        <h1>All your devices,<br />one conversation.</h1>
        <p class="lead">
          Send text, files and whole folders of any size between your computers and your phone,
          share the clipboard, and take control of another screen. Straight across your own
          network, encrypted end to end.
        </p>
        <div class="actions">
          <a class="btn primary" href="#download">Download dsync</a>
          <a class="btn" href={r.android.href} data-dl="android">Get the Android app</a>
          <a class="btn" href={r.ios.href} data-dl="ios">Get the iPhone app</a>
        </div>
        <div class="window">
          <Image src={chat} alt="dsync on Linux, talking with a Windows PC" loading="eager" {...deskShot} sizes="(max-width: 1100px) 92vw, 1040px" widths={[800, 1200, 2000]} />
        </div>
      </section>

      <div class="wrap" id="features">
        <Feature eyebrow="Send anything" title="Text, files and folders. Any size.">
          <p>
            Every device is a conversation. Type a command, paste a screenshot, or drop a folder
            of 200 photos; it arrives in your Downloads folder on the other side.
          </p>
          <ul>
            <li>No size limit. A 6 GB ISO moves at full network speed.</li>
            <li>Transfers pick up where they stopped if Wi-Fi drops.</li>
            <li>Every file is checked with SHA-256 when it lands.</li>
          </ul>
          <div slot="media" class="window"><Image src={dark} alt="A conversation in dark mode, with files and a transfer in progress" {...deskShot} /></div>
        </Feature>

        <Feature eyebrow="Remote control" title="Use another computer from this one." flip>
          <p>
            Open the other screen in a window or full screen, with your own mouse and keyboard.
            dsync sets up Sunshine and Moonlight for you, so it's sharp and fast enough for real
            work.
          </p>
          <ul>
            <li>Choose which screen, how big, and how sharp.</li>
            <li>Desktop or game mouse, with its own pointer speed.</li>
            <li>Pairs itself the first time; no PINs to type across the room.</li>
          </ul>
          <div slot="media" class="card"><Image src={control} alt="Remote control options: screen, size, quality and mouse" widths={[500, 900]} sizes="(max-width: 820px) 92vw, 460px" /></div>
        </Feature>

        <Feature eyebrow="Phone app" title="Your phone joins in.">
          <p>
            Send photos and files from your phone to a computer, or pick up what a computer sent
            you. Paste your phone's clipboard, copy a link back, save or share any file.
          </p>
          <div class="actions">
            <a class="btn primary" href={r.android.href} data-dl="android">Download for Android{r.android.size && <span class="muted-inline">APK · {r.android.size}</span>}</a>
            <a class="btn" href={r.ios.href} data-dl="ios">Download for iPhone{r.ios.size && <span class="muted-inline">IPA · {r.ios.size}</span>}</a>
          </div>
          <p class="note">
            On iPhone, install the file with <a href="https://altstore.io">AltStore</a> or <a href="https://sideloadly.io">Sideloadly</a> using your Apple ID (iOS 16.4 or later).
          </p>
          <div slot="media" class="phones">
            <div class="phone"><Image src={phoneList} alt="Paired computers on the phone" {...phoneShot} /></div>
            <div class="phone raised"><Image src={phoneChat} alt="A conversation on the phone with a file to save" {...phoneShot} /></div>
          </div>
        </Feature>

        <Feature eyebrow="Private by design" title="Pair once. Encrypted always." flip>
          <p>
            Devices find each other on your network. Pair them by checking that both screens show
            the same code, or scan a QR code with your phone. After that, everything between them
            is encrypted, and nothing goes through a server.
          </p>
          <ul>
            <li>TLS 1.3 with pinned keys between computers.</li>
            <li>XSalsa20-Poly1305 between phone and computer.</li>
            <li>Works over Tailscale when you're away from home.</li>
          </ul>
          <div slot="media" class="card narrow"><Image src={qr} alt="The QR code a computer shows to connect a phone" widths={[420, 840]} sizes="(max-width: 820px) 80vw, 380px" /></div>
        </Feature>

        <Feature eyebrow="Stays out of the way" title="Clipboard, tray and updates.">
          <p>
            Copy on one computer and paste on the other, including images. dsync lives in the
            tray, starts with your computer, and updates itself from GitHub with one click.
          </p>
          <ul>
            <li>Shared clipboard you can turn off at any time.</li>
            <li>Clear a conversation or all history when you like.</li>
            <li>Updates are checked against the release's checksums.</li>
          </ul>
          <div slot="media" class="card"><Image src={settings} alt="dsync settings: shared clipboard and running in the background" widths={[500, 900]} sizes="(max-width: 820px) 92vw, 460px" /></div>
        </Feature>
      </div>

      <section class="download wrap" id="download">
        <h2>Download</h2>
        <p class="lead small">{version}. Free, and it only talks to your own devices.</p>
        <div class="grid">
          <a class="dl" href={r.windows.href} data-dl="windows">
            <b>Windows</b>
            <span>Installer{r.windows.size && ` · ${r.windows.size}`}</span>
            <small>Windows 10 and 11. Sets up the firewall for you.</small>
          </a>
          <a class="dl" href={r.mac.href} data-dl="mac">
            <b>macOS</b>
            <span>Disk image{r.mac.size && ` · ${r.mac.size}`}</span>
            <small>Apple Silicon and Intel. First time: right-click → Open.</small>
          </a>
          <a class="dl" href={r.arch.href} data-dl="arch">
            <b>Arch Linux</b>
            <span>Package{r.arch.size && ` · ${r.arch.size}`}</span>
            <small><code>sudo pacman -U</code> the file. Also CachyOS, Manjaro.</small>
          </a>
          <a class="dl" href={r.linux.href} data-dl="linux">
            <b>Other Linux</b>
            <span>Archive{r.linux.size && ` · ${r.linux.size}`}</span>
            <small>Unpack and run <code>./install.sh</code>. Needs WebKitGTK 4.1.</small>
          </a>
          <a class="dl accent" href={r.android.href} data-dl="android">
            <b>Android</b>
            <span>APK{r.android.size && ` · ${r.android.size}`}</span>
            <small>Open it on your phone and allow installing from your browser.</small>
          </a>
          <a class="dl" href={r.ios.href} data-dl="ios" id="iphone">
            <b>iPhone</b>
            <span>Unsigned app{r.ios.size && ` · ${r.ios.size}`}</span>
            <small>Install with AltStore or Sideloadly using your Apple ID. iOS 16.4+.</small>
          </a>
        </div>
        <p class="more"><a href={releasesUrl}>All files and release notes →</a></p>
      </section>
    </main>

    <footer class="wrap">
      <span>dsync</span>
      <a href={repoUrl}>Source on GitHub</a>
    </footer>

    <script>
      // The links were filled in when the site was built; a release made
      // since then is picked up here, so the buttons never lag behind.
      const patterns: Record<string, RegExp> = {
        windows: /-windows-amd64\.exe$/,
        linux: /-linux-x86_64\.tar\.gz$/,
        arch: /\.pkg\.tar\.zst$/,
        mac: /-macos-universal\.dmg$/,
        android: /-android\.apk$/,
        ios: /-ios-unsigned\.ipa$/,
      }
      fetch('https://api.github.com/repos/muhammedaslan34/dsync/releases/latest')
        .then((r) => (r.ok ? r.json() : null))
        .then((rel) => {
          if (!rel?.assets) return
          document.querySelectorAll<HTMLAnchorElement>('[data-dl]').forEach((a) => {
            const asset = rel.assets.find((x: { name: string }) => patterns[a.dataset.dl!]?.test(x.name))
            if (asset) a.href = asset.browser_download_url
          })
        })
        .catch(() => {})
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --soft: #f6f6f9;
    --text: #16161d;
    --muted: #5d5d6b;
    --line: #ececf1;
    --accent: #5b5bd6;
    --accent-text: #ffffff;
    --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 40px -12px rgb(30 30 60 / 0.18);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f14;
      --soft: #17171e;
      --text: #ededf2;
      --muted: #a0a0ae;
      --line: #24242d;
      --accent: #8b8bf5;
      --accent-text: #0f0f14;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 48px -16px rgb(0 0 0 / 0.7);
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1.0625rem/1.65 'Inter Variable', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  code {
    font-size: 0.9em;
    background: var(--soft);
    border-radius: 4px;
    padding: 0.05em 0.3em;
  }
  .wrap {
    width: min(1120px, 100% - 2rem);
    margin-inline: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.95rem;
  }
  .nav nav a {
    text-decoration: none;
    color: var(--muted);
  }
  .nav nav a:hover {
    color: var(--text);
  }
  .hero {
    text-align: center;
    padding: clamp(3rem, 9vw, 6rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .pill {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    margin: 0 0 1.75rem;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  .lead {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 40rem;
    margin: 0 auto 2rem;
  }
  .lead.small {
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .feature-text .actions {
    justify-content: flex-start;
    margin-top: 1.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.3rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    transition: transform 0.15s, background 0.15s;
  }
  .btn:hover {
    transform: translateY(-1px);
    background: var(--soft);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .btn.primary:hover {
    background: var(--accent);
    filter: brightness(1.08);
  }
  .note {
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }
  .muted-inline {
    font-weight: 500;
    opacity: 0.75;
    font-size: 0.85em;
  }
  .window,
  .card,
  .phone {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .hero .window {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .card {
    max-width: 460px;
  }
  .card.narrow {
    max-width: 380px;
  }
  .phones {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .phone {
    width: min(260px, 42vw);
    border-radius: 28px;
  }
  .phone.raised {
    margin-top: 2.5rem;
  }
  .download {
    text-align: center;
    padding: clamp(3rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--line);
  }
  .download h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    text-align: left;
  }
  .dl {
    display: grid;
    gap: 0.2rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .dl:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .dl b {
    font-size: 1.1rem;
  }
  .dl span {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .dl small {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
    margin-top: 0.3rem;
  }
  .dl.accent {
    background: var(--soft);
  }
  .more {
    margin-top: 2rem;
  }
  .more a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  footer {
    display: flex;
    justify-content: space-between;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  footer a {
    text-decoration: none;
  }
</style>
