---
import '@fontsource-variable/inter'
import { Image } from 'astro:assets'
import { siGithub } from 'simple-icons'
import Feature from '../components/Feature.astro'
import Icon from '../components/Icon.astro'
import RemoteAnim from '../components/RemoteAnim.astro'
import { latestRelease, starCount, releasesUrl, repoUrl } from '../release'
import { platforms, order } from '../platforms'

import chat from '../assets/desktop-chat.png'
import dark from '../assets/desktop-dark.png'
import control from '../assets/desktop-control-top.png'
import settings from '../assets/desktop-settings.png'
import qr from '../assets/desktop-phone.png'
import phoneChat from '../assets/phone-chat.png'
import phoneList from '../assets/phone-computers.png'

const [r, stars] = await Promise.all([latestRelease(), starCount()])
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const version = r.version ? `Version ${r.version}` : 'Latest version'
const phoneShot = { widths: [300, 600], sizes: '(max-width: 820px) 42vw, 260px' }
const deskShot = { widths: [640, 1100, 1600], sizes: '(max-width: 820px) 92vw, 640px' }
const starPath =
  'M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z'

// What each download link carries for the download dialog.
const dl = (key: keyof typeof platforms) => ({
  href: r[key].href,
  'data-dl': key,
  'data-name': platforms[key].name,
  'data-kind': platforms[key].kind,
  'data-size': r[key].size ?? '',
  'data-tip': platforms[key].tip,
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>dsync — all your devices, one conversation</title>
    <meta name="description" content="Send text, files and folders of any size between your computers and phone, share the clipboard, and control your other computers. Encrypted, on your own network." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href={`${base}/`}>
        <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
        dsync
      </a>
      <nav>
        <a class="hide-sm" href="#features">Features</a>
        <a class="hide-sm" href="#remote">Remote control</a>
        <a href="#download">Download</a>
        <a class="star-btn" href={repoUrl} target="_blank" rel="noopener">
          <Icon path={siGithub.path} size={16} />
          <span class="hide-sm">Star</span>
          <span class="star-count" data-stars>{stars}</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <p class="pill rise">{version} · Windows · macOS · Linux · Android · iPhone</p>
        <h1 class="rise">All your devices,<br />one conversation.</h1>
        <p class="lead rise">
          Send text, files and whole folders of any size between your computers and your phone,
          share the clipboard, and take control of another screen. Straight across your own
          network, encrypted end to end.
        </p>
        <div class="actions rise">
          <a class="btn primary" href="#download" data-os-default>Download dsync</a>
          {order.map((key) => (
            <a class="btn primary" hidden data-os-button={key} {...dl(key)}>
              <Icon platform={key} />
              Download for {platforms[key].name}
            </a>
          ))}
          <a class="btn" data-os-alt="android" {...dl('android')}><Icon platform="android" /> Android app</a>
          <a class="btn" data-os-alt="ios" {...dl('ios')}><Icon platform="ios" /> iPhone app</a>
        </div>
        <p class="also rise" hidden data-os-also>
          Also for <a href="#download">other systems</a>.
        </p>
        <div class="window hero-shot rise">
          <Image src={chat} alt="dsync on Linux, talking with a Windows PC" loading="eager" widths={[800, 1200, 2000]} sizes="(max-width: 1100px) 92vw, 1040px" />
        </div>
      </section>

      <div class="wrap" id="features">
        <Feature eyebrow="Send anything" title="Text, files and folders. Any size.">
          <p>
            Every device is a conversation. Type a command, paste a screenshot, or drop a folder
            of 200 photos; it arrives in your Downloads folder on the other side.
          </p>
          <ul>
            <li>No size limit. A 6 GB ISO moves at full network speed.</li>
            <li>Transfers pick up where they stopped if Wi-Fi drops.</li>
            <li>Every file is checked with SHA-256 when it lands.</li>
          </ul>
          <div slot="media" class="window lift"><Image src={dark} alt="A conversation in dark mode, with files and a transfer in progress" {...deskShot} /></div>
        </Feature>

        <Feature eyebrow="Remote control" title="Use another computer from this one." flip id="remote">
          <p>
            Open the other screen in a window or full screen, with your own mouse and keyboard.
            dsync sets up Sunshine and Moonlight for you, so it's sharp and fast enough for real
            work.
          </p>
          <ul>
            <li>Choose which screen, how big, and how sharp.</li>
            <li>Desktop or game mouse, with its own pointer speed.</li>
            <li>Pairs itself the first time; no PINs to type across the room.</li>
          </ul>
          <div slot="media" class="remote-media">
            <div class="card anim-card"><RemoteAnim /></div>
            <div class="card faded lift"><Image src={control} alt="Remote control options: screen, size and quality" widths={[470, 940]} sizes="(max-width: 820px) 80vw, 380px" /></div>
          </div>
        </Feature>

        <Feature eyebrow="Phone app" title="Your phone joins in.">
          <p>
            Send photos and files from your phone to a computer, or pick up what a computer sent
            you. Paste your phone's clipboard, copy a link back, save or share any file.
          </p>
          <div class="actions">
            <a class="btn primary" {...dl('android')}><Icon platform="android" /> Android{r.android.size && <span class="muted-inline">APK · {r.android.size}</span>}</a>
            <a class="btn" {...dl('ios')}><Icon platform="ios" /> iPhone{r.ios.size && <span class="muted-inline">IPA · {r.ios.size}</span>}</a>
          </div>
          <p class="note">On iPhone, install the file with <a href="https://altstore.io">AltStore</a> or <a href="https://sideloadly.io">Sideloadly</a> using your Apple ID (iOS 16.4 or later).</p>
          <div slot="media" class="phones">
            <div class="phone float"><Image src={phoneList} alt="Paired computers on the phone" {...phoneShot} /></div>
            <div class="phone raised float late"><Image src={phoneChat} alt="A conversation on the phone with a file to save" {...phoneShot} /></div>
          </div>
        </Feature>

        <Feature eyebrow="Private by design" title="Pair once. Encrypted always." flip>
          <p>
            Devices find each other on your network. Pair them by checking that both screens show
            the same code, or scan a QR code with your phone. After that, everything between them
            is encrypted, and nothing goes through a server.
          </p>
          <ul>
            <li>TLS 1.3 with pinned keys between computers.</li>
            <li>XSalsa20-Poly1305 between phone and computer.</li>
            <li>Works over Tailscale when you're away from home.</li>
          </ul>
          <div slot="media" class="card narrow lift"><Image src={qr} alt="The QR code a computer shows to connect a phone" widths={[420, 840]} sizes="(max-width: 820px) 80vw, 380px" /></div>
        </Feature>

        <Feature eyebrow="Stays out of the way" title="Clipboard, tray and updates.">
          <p>
            Copy on one computer and paste on the other, including images. dsync lives in the
            tray, starts with your computer, and updates itself from GitHub with one click.
          </p>
          <ul>
            <li>Shared clipboard you can turn off at any time.</li>
            <li>Clear a conversation or all history when you like.</li>
            <li>Updates are checked against the release's checksums.</li>
          </ul>
          <div slot="media" class="card lift"><Image src={settings} alt="dsync settings: shared clipboard and running in the background" widths={[500, 1000]} sizes="(max-width: 820px) 92vw, 460px" /></div>
        </Feature>
      </div>

      <section class="download wrap reveal" id="download">
        <h2>Download</h2>
        <p class="lead small">{version}. Free, and it only talks to your own devices.</p>
        <div class="grid">
          {order.map((key) => (
            <a class="dl" {...dl(key)} id={key === 'ios' ? 'iphone' : undefined}>
              <span class="dl-head">
                <span class="dl-icon"><Icon platform={key} size={20} /></span>
                <b>{platforms[key].name}</b>
                <em class="for-you">For this device</em>
              </span>
              <span class="dl-kind">{platforms[key].kind}{r[key].size && ` · ${r[key].size}`}</span>
              <small>{platforms[key].note}</small>
            </a>
          ))}
        </div>
        <p class="more"><a href={releasesUrl}>All files and release notes →</a></p>
      </section>
    </main>

    <footer class="wrap">
      <span>dsync</span>
      <a href={repoUrl}>Source on GitHub</a>
    </footer>

    <dialog class="modal" id="dl-modal" aria-labelledby="dl-title">
      <form method="dialog" class="modal-close"><button aria-label="Close">✕</button></form>
      <div class="modal-icon" data-modal-icon></div>
      <h3 id="dl-title">Download dsync for <span data-modal-name></span></h3>
      <p class="modal-meta" data-modal-meta></p>

      <div class="modal-ask">
        <p>
          dsync is free and made by one person. If it's useful to you, a star on GitHub helps
          other people find it.
        </p>
        <a class="btn star-cta" href={repoUrl} target="_blank" rel="noopener">
          <Icon path={starPath} size={18} class="star-icon" />
          Star on GitHub
          <span class="star-count" data-stars>{stars}</span>
        </a>
      </div>

      <a class="btn primary modal-go" data-modal-go href="#">Download</a>
      <p class="modal-done" data-modal-done hidden>
        Your download has started. Thank you!
        <a data-modal-again href="#">Download again</a>
      </p>
      <p class="modal-tip" data-modal-tip></p>
    </dialog>

    <script>
      // 1. Keep download links on the newest release, even between site builds.
      const patterns: Record<string, RegExp> = {
        windows: /-windows-amd64\.exe$/,
        linux: /-linux-x86_64\.tar\.gz$/,
        arch: /\.pkg\.tar\.zst$/,
        mac: /-macos-universal\.dmg$/,
        android: /-android\.apk$/,
        ios: /-ios-unsigned\.ipa$/,
      }
      fetch('https://api.github.com/repos/muhammedaslan34/dsync/releases/latest')
        .then((r) => (r.ok ? r.json() : null))
        .then((rel) => {
          if (!rel?.assets) return
          document.querySelectorAll<HTMLAnchorElement>('[data-dl]').forEach((a) => {
            const asset = rel.assets.find((x: { name: string }) => patterns[a.dataset.dl!]?.test(x.name))
            if (asset) a.href = asset.browser_download_url
          })
        })
        .catch(() => {})

      // 2. The live star count.
      fetch('https://api.github.com/repos/muhammedaslan34/dsync')
        .then((r) => (r.ok ? r.json() : null))
        .then((repo) => {
          if (typeof repo?.stargazers_count !== 'number') return
          document.querySelectorAll('[data-stars]').forEach((el) => {
            el.textContent = repo.stargazers_count.toLocaleString()
          })
        })
        .catch(() => {})

      // 3. Offer the download for this device first.
      function detectOS(): string | null {
        const ua = navigator.userAgent
        const nav = navigator as Navigator & { userAgentData?: { platform?: string } }
        const platform = (nav.userAgentData?.platform || navigator.platform || '').toLowerCase()
        if (/android/i.test(ua)) return 'android'
        if (/iphone|ipad|ipod/i.test(ua) || (platform === 'macintel' && navigator.maxTouchPoints > 1)) return 'ios'
        if (platform.startsWith('win') || /windows/i.test(ua)) return 'windows'
        if (platform.startsWith('mac')) return 'mac'
        if (/linux|x11|cros/i.test(platform + ' ' + ua)) return 'linux'
        return null
      }
      const os = detectOS()
      if (os) {
        const btn = document.querySelector<HTMLElement>(`[data-os-button="${os}"]`)
        if (btn) {
          btn.hidden = false
          document.querySelector<HTMLElement>('[data-os-default]')!.hidden = true
          document.querySelector<HTMLElement>('[data-os-also]')!.hidden = false
          // Don't offer the same phone app twice.
          document.querySelector<HTMLElement>(`[data-os-alt="${os}"]`)?.setAttribute('hidden', '')
        }
        document.querySelector(`.dl[data-dl="${os}"]`)?.classList.add('mine')
      }

      // 4. Download dialog: ask for a star, then download.
      const modal = document.getElementById('dl-modal') as HTMLDialogElement
      const go = modal.querySelector<HTMLAnchorElement>('[data-modal-go]')!
      const done = modal.querySelector<HTMLElement>('[data-modal-done]')!
      document.querySelectorAll<HTMLAnchorElement>('a[data-dl]').forEach((a) => {
        a.addEventListener('click', (e) => {
          if (!modal.showModal || e.metaKey || e.ctrlKey || e.shiftKey) return
          e.preventDefault()
          const d = a.dataset
          modal.querySelector('[data-modal-name]')!.textContent = d.name!
          modal.querySelector('[data-modal-meta]')!.textContent = [d.kind, d.size].filter(Boolean).join(' · ')
          modal.querySelector('[data-modal-tip]')!.textContent = d.tip!
          const icon = a.querySelector('svg')?.cloneNode(true) ?? document.querySelector(`.dl[data-dl="${d.dl}"] svg`)?.cloneNode(true)
          modal.querySelector('[data-modal-icon]')!.replaceChildren(...(icon ? [icon] : []))
          go.href = a.href
          go.hidden = false
          done.hidden = true
          modal.showModal()
        })
      })
      go.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return
        // Download in a hidden frame, so this page (and the thank-you) stays.
        e.preventDefault()
        let frame = document.getElementById('dl-frame') as HTMLIFrameElement | null
        if (!frame) {
          frame = document.createElement('iframe')
          frame.id = 'dl-frame'
          frame.hidden = true
          document.body.append(frame)
        }
        frame.src = go.href
        modal.querySelector<HTMLAnchorElement>('[data-modal-again]')!.href = go.href
        go.hidden = true
        done.hidden = false
      })
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close()
      })

      // 5. Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (en.isIntersecting) {
              en.target.classList.add('in')
              io.unobserve(en.target)
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      )
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el))
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --soft: #f6f6f9;
    --text: #16161d;
    --muted: #5d5d6b;
    --line: #ececf1;
    --accent: #5b5bd6;
    --accent-text: #ffffff;
    --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 40px -12px rgb(30 30 60 / 0.18);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f14;
      --soft: #17171e;
      --text: #ededf2;
      --muted: #a0a0ae;
      --line: #24242d;
      --accent: #8b8bf5;
      --accent-text: #0f0f14;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 48px -16px rgb(0 0 0 / 0.7);
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1.0625rem/1.65 'Inter Variable', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  [hidden] {
    display: none !important;
  }
  .icon {
    flex: none;
  }
  .wrap {
    width: min(1120px, 100% - 2rem);
    margin-inline: auto;
  }

  /* Navigation */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.95rem;
  }
  .nav nav a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s;
  }
  .nav nav a:hover {
    color: var(--text);
  }
  .nav nav .star-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.4rem 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s var(--ease);
  }
  .nav nav .star-btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .star-count {
    min-width: 1.6em;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.85em;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 600px) {
    .hide-sm {
      display: none;
    }
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: clamp(3rem, 9vw, 6rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .pill {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    margin: 0 0 1.75rem;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  .lead {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 40rem;
    margin: 0 auto 2rem;
  }
  .lead.small {
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }
  .also {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .also a {
    color: var(--accent);
  }
  .hero-shot {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .feature-text .actions {
    justify-content: flex-start;
    margin-top: 1.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.3rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s var(--ease), background 0.2s, box-shadow 0.2s, filter 0.2s;
  }
  .btn:hover {
    transform: translateY(-2px);
    background: var(--soft);
  }
  .btn:active {
    transform: translateY(0);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    box-shadow: 0 6px 20px -8px var(--accent);
  }
  .btn.primary:hover {
    filter: brightness(1.08);
    box-shadow: 0 10px 28px -8px var(--accent);
  }
  .muted-inline {
    font-weight: 500;
    opacity: 0.75;
    font-size: 0.85em;
  }
  .note {
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }

  /* Screenshots */
  .window,
  .card,
  .phone {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    background: var(--bg);
  }
  .lift {
    transition: transform 0.5s var(--ease), box-shadow 0.5s;
  }
  .lift:hover {
    transform: translateY(-6px);
  }
  .card {
    max-width: 460px;
  }
  .card.narrow {
    max-width: 380px;
  }
  .remote-media {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
    width: 100%;
  }
  .anim-card {
    max-width: 520px;
    width: 100%;
    padding: 1rem 1rem 0.25rem;
  }
  .card.faded {
    max-width: 380px;
    margin-top: -0.25rem;
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    border-bottom: none;
  }
  .phones {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .phone {
    width: min(260px, 42vw);
    border-radius: 28px;
  }
  .phone.raised {
    margin-top: 2.5rem;
  }

  /* Downloads */
  .download {
    text-align: center;
    padding: clamp(3rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--line);
  }
  .download h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    text-align: left;
  }
  .dl {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.25s var(--ease), box-shadow 0.25s;
  }
  .dl:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .dl-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .dl-icon {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9px;
    background: var(--soft);
    color: var(--text);
    transition: background 0.2s, color 0.2s;
  }
  .dl:hover .dl-icon,
  .dl.mine .dl-icon {
    background: var(--accent);
    color: var(--accent-text);
  }
  .dl b {
    font-size: 1.1rem;
  }
  .for-you {
    display: none;
    white-space: nowrap;
    margin-left: auto;
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }
  .dl.mine {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
