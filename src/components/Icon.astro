---
// A 24x24 filled logo path (platform logos from Simple Icons).
import { platforms, type PlatformKey } from '../platforms'
interface Props {
  platform?: PlatformKey
  path?: string
  size?: number
  class?: string
}
const { platform, path, size = 18, class: cls } = Astro.props
const d = path ?? (platform ? platforms[platform].icon : '')
---

<svg class:list={['icon', cls]} viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true"><path d={d} /></svg>
