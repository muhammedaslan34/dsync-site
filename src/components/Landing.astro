---
import '@fontsource-variable/inter'
import '@fontsource-variable/noto-sans-arabic'
import { Image } from 'astro:assets'
import { siGithub } from 'simple-icons'
import Feature from './Feature.astro'
import Icon from './Icon.astro'
import RemoteAnim from './RemoteAnim.astro'
import { latestRelease, starCount, releasesUrl, repoUrl } from '../release'
import { order, type PlatformKey } from '../platforms'
import { dicts, langs, fill, pathFor, type Lang } from '../i18n'

import chat from '../assets/desktop-chat.png'
import dark from '../assets/desktop-dark.png'
import control from '../assets/desktop-control-top.png'
import settings from '../assets/desktop-settings.png'
import qr from '../assets/desktop-phone.png'
import phoneChat from '../assets/phone-chat.png'
import phoneList from '../assets/phone-computers.png'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = dicts[lang]
const dir = langs.find((l) => l.code === lang)!.dir

const [r, stars] = await Promise.all([latestRelease(), starCount()])
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const version = r.version ? fill(t.hero.version, { v: r.version }) : t.hero.latest
const phoneShot = { widths: [300, 600], sizes: '(max-width: 820px) 42vw, 260px' }
const deskShot = { widths: [640, 1100, 1600], sizes: '(max-width: 820px) 92vw, 640px' }
const starPath =
  'M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z'
const site = Astro.site?.origin ?? ''
const [leadBefore, leadAfter = ''] = t.download.lead.split('{version}')

// What each download link carries for the download dialog.
const dl = (key: PlatformKey) => ({
  href: r[key].href,
  'data-dl': key,
  'data-title': fill(t.modal.title, { name: t.platforms[key].name }),
  'data-kind': t.platforms[key].kind,
  'data-size': r[key].size ?? '',
  'data-tip': t.platforms[key].tip,
})
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    {langs.map((l) => <link rel="alternate" hreflang={l.code} href={site + pathFor(l.code)} />)}
    <link rel="alternate" hreflang="x-default" href={site + pathFor('en')} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {lang === 'en' && (
      <script is:inline define:vars={{ paths: Object.fromEntries(langs.map((l) => [l.code, pathFor(l.code)])) }}>
        // First visit to the English page: show the visitor's language if
        // we have it. Choosing a language in the menu is remembered.
        try {
          if (!localStorage.getItem('lang')) {
            const want = (navigator.languages || [navigator.language]).map((l) => l.slice(0, 2).toLowerCase())
            const hit = want.find((l) => l !== 'en' && paths[l])
            if (hit && want.indexOf(hit) < (want.indexOf('en') + 1 || Infinity)) location.replace(paths[hit] + location.hash)
          }
        } catch {}
      </script>
    )}
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href={pathFor(lang)}>
        <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
        dsync
      </a>
      <nav>
        <a class="hide-sm" href="#features">{t.nav.features}</a>
        <a class="hide-sm" href="#remote">{t.nav.remote}</a>
        <a class="hide-xs" href="#download">{t.nav.download}</a>
        <details class="lang">
          <summary aria-label={t.nav.language}>
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
            {lang.toUpperCase()}
          </summary>
          <ul>
            {langs.map((l) => (
              <li><a href={pathFor(l.code)} lang={l.code} data-lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a></li>
            ))}
          </ul>
        </details>
        <a class="star-btn" href={repoUrl} target="_blank" rel="noopener">
          <Icon path={siGithub.path} size={16} />
          <span class="hide-sm">{t.nav.star}</span>
          <span class="star-count" data-stars>{stars}</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <p class="pill rise"><bdi data-version={t.hero.version}>{version}</bdi><span class="pill-sep"> · </span><bdi dir="ltr" class="pill-os">Windows · macOS · Linux · Android · iPhone</bdi></p>
        <h1 class="rise">{t.hero.title1}<br />{t.hero.title2}</h1>
        <p class="lead rise">{t.hero.lead}</p>
        <div class="actions rise">
          <a class="btn primary" href="#download" data-os-default>{t.hero.download}</a>
          {order.map((key) => (
            <a class="btn primary" hidden data-os-button={key} {...dl(key)}>
              <Icon platform={key} />
              {fill(t.hero.downloadFor, { name: t.platforms[key].name })}
            </a>
          ))}
          <a class="btn" data-os-alt="android" {...dl('android')}><Icon platform="android" /> {t.hero.androidApp}</a>
          <a class="btn" data-os-alt="ios" {...dl('ios')}><Icon platform="ios" /> {t.hero.iphoneApp}</a>
        </div>
        <p class="also rise" hidden data-os-also set:html={t.hero.alsoHtml} />
        <div class="window hero-shot rise">
          <Image src={chat} alt={t.alt.hero} loading="eager" widths={[800, 1200, 2000]} sizes="(max-width: 1100px) 92vw, 1040px" />
        </div>
      </section>

      <div class="wrap" id="features">
        <Feature eyebrow={t.send.eyebrow} title={t.send.title}>
          <p>{t.send.text}</p>
          <ul>{t.send.points.map((p) => <li>{p}</li>)}</ul>
          <div slot="media" class="window lift"><Image src={dark} alt={t.alt.dark} {...deskShot} /></div>
        </Feature>

        <Feature eyebrow={t.remote.eyebrow} title={t.remote.title} flip id="remote">
          <p>{t.remote.text}</p>
          <ul>{t.remote.points.map((p) => <li>{p}</li>)}</ul>
          <div slot="media" class="remote-media">
            <div class="card anim-card"><RemoteAnim labels={t.anim} /></div>
            <div class="card faded lift"><Image src={control} alt={t.alt.control} widths={[470, 940]} sizes="(max-width: 820px) 80vw, 380px" /></div>
          </div>
        </Feature>

        <Feature eyebrow={t.phone.eyebrow} title={t.phone.title}>
          <p>{t.phone.text}</p>
          <div class="actions">
            <a class="btn primary" {...dl('android')}><Icon platform="android" /> Android{r.android.size && <span class="muted-inline" dir="ltr">APK · {r.android.size}</span>}</a>
            <a class="btn" {...dl('ios')}><Icon platform="ios" /> iPhone{r.ios.size && <span class="muted-inline" dir="ltr">IPA · {r.ios.size}</span>}</a>
          </div>
          <p class="note" set:html={t.phone.noteHtml} />
          <div slot="media" class="phones">
            <div class="phone float"><Image src={phoneList} alt={t.alt.phoneList} {...phoneShot} /></div>
            <div class="phone raised float late"><Image src={phoneChat} alt={t.alt.phoneChat} {...phoneShot} /></div>
          </div>
        </Feature>

        <Feature eyebrow={t.private.eyebrow} title={t.private.title} flip>
          <p>{t.private.text}</p>
          <ul>{t.private.points.map((p) => <li>{p}</li>)}</ul>
          <div slot="media" class="card narrow lift"><Image src={qr} alt={t.alt.qr} widths={[420, 840]} sizes="(max-width: 820px) 80vw, 380px" /></div>
        </Feature>

        <Feature eyebrow={t.tray.eyebrow} title={t.tray.title}>
          <p>{t.tray.text}</p>
          <ul>{t.tray.points.map((p) => <li>{p}</li>)}</ul>
          <div slot="media" class="card lift"><Image src={settings} alt={t.alt.settings} widths={[500, 1000]} sizes="(max-width: 820px) 92vw, 460px" /></div>
        </Feature>
      </div>

      <section class="download wrap reveal" id="download">
        <h2>{t.download.title}</h2>
        <p class="lead small">{leadBefore}<bdi data-version={t.hero.version}>{version}</bdi>{leadAfter}</p>
        <div class="grid">
          {order.map((key) => (
            <a class="dl" {...dl(key)} id={key === 'ios' ? 'iphone' : undefined}>
              <span class="dl-head">
                <span class="dl-icon"><Icon platform={key} size={20} /></span>
                <b>{t.platforms[key].name}</b>
                <em class="for-you">{t.download.forYou}</em>
              </span>
              <span class="dl-kind">{t.platforms[key].kind}<span data-size-wrap hidden={!r[key].size}> · <bdi dir="ltr" data-size-of={key}>{r[key].size}</bdi></span></span>
              <small>{t.platforms[key].note}</small>
            </a>
          ))}
        </div>
        <p class="more"><a href={releasesUrl}>{t.download.all}</a></p>
      </section>
    </main>

    <footer class="wrap">
      <span>dsync</span>
      <a href={repoUrl}>{t.footer.source}</a>
    </footer>

    <dialog class="modal" id="dl-modal" aria-labelledby="dl-title">
      <form method="dialog" class="modal-close"><button aria-label={t.modal.close}>✕</button></form>
      <div class="modal-icon" data-modal-icon></div>
      <h3 id="dl-title" data-modal-title></h3>
      <p class="modal-meta" data-modal-meta></p>

      <div class="modal-ask">
        <p>{t.modal.ask}</p>
        <a class="btn star-cta" href={repoUrl} target="_blank" rel="noopener">
          <Icon path={starPath} size={18} class="star-icon" />
          {t.modal.star}
          <span class="star-count" data-stars>{stars}</span>
        </a>
      </div>

      <a class="btn primary modal-go" data-modal-go href="#">{t.modal.go}</a>
      <p class="modal-done" data-modal-done hidden>
        {t.modal.done}
        <a data-modal-again href="#">{t.modal.again}</a>
      </p>
      <p class="modal-tip" data-modal-tip></p>
    </dialog>
    <script>
      // 1. Keep download links on the newest release, even between site builds.
      const patterns: Record<string, RegExp> = {
        windows: /-windows-amd64\.exe$/,
        linux: /-linux-x86_64\.tar\.gz$/,
        arch: /\.pkg\.tar\.zst$/,
        mac: /-macos-universal\.dmg$/,
        android: /-android\.apk$/,
        ios: /-ios-unsigned\.ipa$/,
      }
      fetch('https://api.github.com/repos/muhammedaslan34/dsync/releases/latest')
        .then((r) => (r.ok ? r.json() : null))
        .then((rel) => {
          if (!rel?.assets) return
          const size = (n: number) => (n >= 1e6 ? `${Math.round(n / 1e6)} MB` : `${Math.round(n / 1e3)} KB`)
          document.querySelectorAll<HTMLAnchorElement>('[data-dl]').forEach((a) => {
            const asset = rel.assets.find((x: { name: string }) => patterns[a.dataset.dl!]?.test(x.name))
            if (!asset) return
            a.href = asset.browser_download_url
            a.dataset.size = size(asset.size)
          })
          // Version and sizes, in case GitHub couldn't be reached when the
          // site was built.
          const v = String(rel.tag_name ?? '').replace(/^v/, '')
          if (v) document.querySelectorAll<HTMLElement>('[data-version]').forEach((el) => (el.textContent = el.dataset.version!.replace('{v}', v)))
          document.querySelectorAll<HTMLElement>('[data-size-of]').forEach((el) => {
            const size = document.querySelector<HTMLElement>(`a[data-dl="${el.dataset.sizeOf}"]`)?.dataset.size
            if (!size) return
            el.textContent = size
            el.parentElement!.hidden = false
          })
        })
        .catch(() => {})

      // 2. The live star count.
      fetch('https://api.github.com/repos/muhammedaslan34/dsync')
        .then((r) => (r.ok ? r.json() : null))
        .then((repo) => {
          if (typeof repo?.stargazers_count !== 'number') return
          document.querySelectorAll('[data-stars]').forEach((el) => {
            el.textContent = repo.stargazers_count.toLocaleString()
          })
        })
        .catch(() => {})

      // 3. Offer the download for this device first.
      function detectOS(): string | null {
        const ua = navigator.userAgent
        const nav = navigator as Navigator & { userAgentData?: { platform?: string } }
        const platform = (nav.userAgentData?.platform || navigator.platform || '').toLowerCase()
        if (/android/i.test(ua)) return 'android'
        if (/iphone|ipad|ipod/i.test(ua) || (platform === 'macintel' && navigator.maxTouchPoints > 1)) return 'ios'
        if (platform.startsWith('win') || /windows/i.test(ua)) return 'windows'
        if (platform.startsWith('mac')) return 'mac'
        if (/linux|x11|cros/i.test(platform + ' ' + ua)) return 'linux'
        return null
      }
      const os = detectOS()
      if (os) {
        const btn = document.querySelector<HTMLElement>(`[data-os-button="${os}"]`)
        if (btn) {
          btn.hidden = false
          document.querySelector<HTMLElement>('[data-os-default]')!.hidden = true
          document.querySelector<HTMLElement>('[data-os-also]')!.hidden = false
          // Don't offer the same phone app twice.
          document.querySelector<HTMLElement>(`[data-os-alt="${os}"]`)?.setAttribute('hidden', '')
        }
        document.querySelector(`.dl[data-dl="${os}"]`)?.classList.add('mine')
      }

      // 4. Download dialog: ask for a star, then download.
      const modal = document.getElementById('dl-modal') as HTMLDialogElement
      const go = modal.querySelector<HTMLAnchorElement>('[data-modal-go]')!
      const done = modal.querySelector<HTMLElement>('[data-modal-done]')!
      document.querySelectorAll<HTMLAnchorElement>('a[data-dl]').forEach((a) => {
        a.addEventListener('click', (e) => {
          if (!modal.showModal || e.metaKey || e.ctrlKey || e.shiftKey) return
          e.preventDefault()
          const d = a.dataset
          modal.querySelector('[data-modal-title]')!.textContent = d.title!
          // The size (e.g. "12 MB") always reads left to right, also in Arabic.
          const size = Object.assign(document.createElement('bdi'), { dir: 'ltr', textContent: d.size ?? '' })
          modal.querySelector('[data-modal-meta]')!.replaceChildren(d.kind!, ...(d.size ? [' · ', size] : []))
          modal.querySelector('[data-modal-tip]')!.textContent = d.tip!
          const icon = a.querySelector('svg')?.cloneNode(true) ?? document.querySelector(`.dl[data-dl="${d.dl}"] svg`)?.cloneNode(true)
          modal.querySelector('[data-modal-icon]')!.replaceChildren(...(icon ? [icon] : []))
          go.href = a.href
          go.hidden = false
          done.hidden = true
          modal.showModal()
        })
      })
      go.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return
        // Download in a hidden frame, so this page (and the thank-you) stays.
        e.preventDefault()
        let frame = document.getElementById('dl-frame') as HTMLIFrameElement | null
        if (!frame) {
          frame = document.createElement('iframe')
          frame.id = 'dl-frame'
          frame.hidden = true
          document.body.append(frame)
        }
        frame.src = go.href
        modal.querySelector<HTMLAnchorElement>('[data-modal-again]')!.href = go.href
        go.hidden = true
        done.hidden = false
      })
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.close()
      })

      // 5. Remember the language picked in the menu.
      document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) =>
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('lang', a.dataset.lang!)
          } catch {}
        }),
      )

      // 6. Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (en.isIntersecting) {
              en.target.classList.add('in')
              io.unobserve(en.target)
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      )
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el))
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --soft: #f6f6f9;
    --text: #16161d;
    --muted: #5d5d6b;
    --line: #ececf1;
    --accent: #5b5bd6;
    --accent-text: #ffffff;
    --shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 12px 40px -12px rgb(30 30 60 / 0.18);
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f14;
      --soft: #17171e;
      --text: #ededf2;
      --muted: #a0a0ae;
      --line: #24242d;
      --accent: #8b8bf5;
      --accent-text: #0f0f14;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 16px 48px -16px rgb(0 0 0 / 0.7);
    }
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1.0625rem/1.65 'Inter Variable', 'Noto Sans Arabic Variable', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
  img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  [hidden] {
    display: none !important;
  }
  .icon {
    flex: none;
  }
  .wrap {
    width: min(1120px, 100% - 2rem);
    margin-inline: auto;
  }

  /* Navigation */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.15rem;
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.95rem;
  }
  .nav nav a {
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s;
  }
  .nav nav a:hover {
    color: var(--text);
  }
  /* Language menu */
  .lang {
    position: relative;
  }
  .lang summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--muted);
    padding: 0.35rem 0.5rem;
    border-radius: 8px;
    transition: color 0.2s, background 0.2s;
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang summary:hover,
  .lang[open] summary {
    color: var(--text);
    background: var(--soft);
  }
  .lang ul {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.4rem);
    z-index: 10;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    min-width: 9rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow);
    animation: pop 0.2s var(--ease);
  }
  .lang li a {
    display: block;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    color: var(--text) !important;
  }
  .lang li a:hover,
  .lang li a[aria-current] {
    background: var(--soft);
  }
  .lang li a[aria-current] {
    font-weight: 600;
  }
  [dir='rtl'] h1 {
    letter-spacing: 0;
    line-height: 1.2;
  }
  [dir='rtl'] h2,
  [dir='rtl'] .modal h3 {
    letter-spacing: 0;
  }
  .nav nav .star-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.4rem 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    transition: border-color 0.2s, transform 0.2s var(--ease);
  }
  .nav nav .star-btn:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .star-count {
    min-width: 1.6em;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--soft);
    font-size: 0.85em;
    font-weight: 600;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 600px) {
    .hide-sm {
      display: none;
    }
  }
  @media (max-width: 360px) {
    .hide-xs {
      display: none;
    }
  }

  /* Hero */
  .hero {
    text-align: center;
    padding: clamp(3rem, 9vw, 6rem) 0 clamp(3rem, 7vw, 5rem);
  }
  .pill {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    margin: 0 0 1.75rem;
  }
  .pill-os {
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .pill-sep {
      display: none;
    }
    .pill-os {
      display: block;
    }
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  .lead {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 40rem;
    margin: 0 auto 2rem;
  }
  .lead.small {
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }
  .also {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .also a {
    color: var(--accent);
  }
  .hero-shot {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  /* Buttons */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .feature-text .actions {
    justify-content: flex-start;
    margin-top: 1.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1.3rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s var(--ease), background 0.2s, box-shadow 0.2s, filter 0.2s;
  }
