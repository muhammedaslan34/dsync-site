---
// One feature: text on one side, its screenshot(s) on the other.
interface Props {
  eyebrow: string
  title: string
  flip?: boolean
  id?: string
}
const { eyebrow, title, flip = false, id } = Astro.props
---

<section class:list={['feature', { flip }]} id={id}>
  <div class="feature-text">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <slot />
  </div>
  <div class="feature-media">
    <slot name="media" />
  </div>
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding: clamp(3rem, 8vw, 6rem) 0;
    border-top: 1px solid var(--line);
  }
  .feature.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .feature.flip .feature-text {
    order: 2;
  }
  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.875rem;
    margin: 0 0 0.75rem;
  }
  h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .feature-text :global(p) {
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .feature-text :global(ul) {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.6rem;
  }
  .feature-text :global(li) {
    padding-left: 1.5rem;
    position: relative;
  }
  .feature-text :global(li)::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.62em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .feature-media {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
  }
  @media (max-width: 820px) {
    .feature,
    .feature.flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .feature.flip .feature-text {
      order: 0;
    }
  }
</style>
